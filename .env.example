# Copy this file to  .env  (project root) or  server/.env  — either works.
#
# IMPORTANT: do NOT `export ANTHROPIC_API_KEY=...` in your shell.
# Claude Code picks that variable up and would bill your API key
# instead of your subscription. Keep it in the .env file only.
ANTHROPIC_API_KEY=sk-ant-...

# Optional for the "Listen to this scene" button. Keep this key on the server.
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_RED_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_WOLF_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_GRANDMA_VOICE_ID=9BWtsMINqrJLrRacOk9x


# Optional. Defaults to claude-haiku-4-5 (cheapest, ~2.5s a reply).
# Trade up with claude-sonnet-5 or claude-opus-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Defaults to 8787, which is what the Vite proxy expects.
# PORT=8787
